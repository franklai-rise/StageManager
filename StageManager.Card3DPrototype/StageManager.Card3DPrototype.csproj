<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<ApplicationIcon>..\StageManager\StageManager.ico</ApplicationIcon>
		<AssemblyName>Stage_Manager_Lai_v4.8.2</AssemblyName>
    <RootNamespace>StageManager.Card3DPrototype</RootNamespace>
		<Version>4.8.2</Version>
		<AssemblyVersion>4.8.2.0</AssemblyVersion>
		<FileVersion>4.8.2.0</FileVersion>
		<InformationalVersion>Stage_Manager_Lai_v4.8.2</InformationalVersion>
	<IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
		<Product>Stage_Manager_Lai_v4.8.2</Product>
	<Authors>Andreas Wäscher; Frank Lai (modified fork)</Authors>
	<Description>Stage Manager for Windows with low-memory 3D window cards, Focus enhanced workspace reservation, stable click targeting, optional quick-launch controls, and a privacy-conscious AI usage card for Codex, DeepSeek, and Kimi.</Description>
	<Copyright>Original copyright (c) 2022 Andreas Wäscher; Lai modifications (c) 2026 Frank Lai</Copyright>
	<RepositoryUrl>https://github.com/franklai-rise/StageManager</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../StageManager.GeminiBridge/GeminiQuotaRecord.cs" Link="AiUsage/GeminiQuotaRecord.cs" />
    <EmbeddedResource Include="AiUsage\Assets\*.png" />
    <ProjectReference Include="..\StageManager\StageManager.csproj" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
