{
  "manifest_version": 3,
  "name": "Stage Manager · Gemini subscription quota",
  "version": "0.1.0",
  "description": "Read Gemini web subscription quota into your local Stage Manager. No API key required.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "optional_host_permissions": ["https://gemini.google.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
