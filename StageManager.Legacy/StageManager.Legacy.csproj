<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>StageManager.ico</ApplicationIcon>
		<AssemblyName>StageManager.Legacy</AssemblyName>
		<Version>2.1.0</Version>
		<AssemblyVersion>2.1.0.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<InformationalVersion>Stage_Manager_Lai_v2.1.0</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Product>Stage_Manager_Lai_v2.1.0</Product>
		<Authors>Andreas Wäscher; Frank Lai (modified fork)</Authors>
		<Description>Personal Stage Manager for Windows with runtime task stages, dual operating modes, multi-display layout restoration, settings, and virtual desktop awareness.</Description>
		<Copyright>Original copyright (c) 2022 Andreas Wäscher; Lai v1 series modifications (c) 2026 Frank Lai</Copyright>
		<RepositoryUrl>https://github.com/franklai-rise/StageManager</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="StageManager.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\StageManager.Core\StageManager.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
		<PackageReference Include="SharpHook" Version="4.2.1" />
	</ItemGroup>

</Project>
