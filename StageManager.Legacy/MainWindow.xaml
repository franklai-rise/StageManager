<Window x:Class="StageManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StageManager"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="Stage_Manager_Lai_v2.1.0"
        Height="450"
        Width="224"
        ShowActivated="False"
        Background="Transparent"
        Name="thisWindow">
    <Window.Resources>
        <Style x:Key="StageCardStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0.96" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#E51B1E25" />
            <Setter Property="BorderBrush" Value="#8A8993A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="13" ShadowDepth="3" Direction="315" Opacity="0.48" Color="Black" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="BorderBrush" Value="#CCB8C7E8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8,8,12,8" Padding="4" CornerRadius="16" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Visibility="{Binding SafeModeVisibility}" Background="#D98A3B22" CornerRadius="9" Padding="9" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Safe mode" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Window control is paused. Open the tray menu to resume." TextWrapping="Wrap"
                                   FontSize="11" Foreground="#FFF6DED5" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalAlignment="Center"
                              MaxHeight="{Binding SceneListMaxHeight}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="scenesControl"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Panel.ZIndex" Value="{Binding PerspectiveZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding SceneCardSlotWidth, Source={x:Reference thisWindow}}"
                                      Height="{Binding SceneCardHeight, Source={x:Reference thisWindow}}"
                                      Margin="{Binding SceneCardMargin, Source={x:Reference thisWindow}}"
                                      Background="Transparent"
                                      Visibility="{Binding Visibility}"
                                      ToolTip="{Binding Title}"
                                      AutomationProperties.Name="{Binding Title}"
                                      MouseLeftButtonUp="StageCard_MouseLeftButtonUp">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Merge into current stage" Click="MenuItem_MergeStage_Click" />
                                            <MenuItem Header="Move one window out" Click="MenuItem_ExtractWindow_Click" />
                                            <Separator />
                                            <MenuItem Header="Move stage to next display" Click="MenuItem_MoveDisplay_Click" />
                                            <MenuItem Header="Arrange windows">
                                                <MenuItem Header="Two columns" Click="MenuItem_TwoColumns_Click" />
                                                <MenuItem Header="Three columns" Click="MenuItem_ThreeColumns_Click" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Rebuild previews" Click="MenuItem_RebuildPreviews_Click" />
                                            <MenuItem Header="Ignore applications in this stage" Click="MenuItem_IgnoreStage_Click" />
                                            <MenuItem Header="Close most recent window" Click="MenuItem_CloseWindow_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid Width="{Binding SceneCardWidth, Source={x:Reference thisWindow}}"
                                          Height="{Binding SceneCardHeight, Source={x:Reference thisWindow}}"
                                          Margin="{Binding PerspectiveCardMargin}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top">
                                        <Border Visibility="{Binding PerspectiveVisibility}"
                                                Margin="-4,0,4,0"
                                                CornerRadius="14"
                                                BorderBrush="#997886A5"
                                                BorderThickness="1"
                                                Opacity="{Binding PerspectiveBackplateOpacity}"
                                                RenderTransformOrigin="0.5,0.5"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E26D7FA8" Offset="0" />
                                                    <GradientStop Color="#D63C465D" Offset="0.48" />
                                                    <GradientStop Color="#E2141821" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <SkewTransform AngleX="{Binding PerspectiveAngle}" />
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="19" ShadowDepth="7" Direction="315" Opacity="0.58" Color="#FF05070B" />
                                            </Border.Effect>
                                        </Border>

                                        <Border Visibility="{Binding PerspectiveVisibility}"
                                                Width="8"
                                                Margin="0,6,-7,6"
                                                HorizontalAlignment="Right"
                                                CornerRadius="0,7,7,0"
                                                BorderBrush="#667E8AA5"
                                                BorderThickness="0,1,1,1"
                                                Opacity="{Binding PerspectiveBackplateOpacity}"
                                                RenderTransformOrigin="0.5,0.5"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#E6535F78" Offset="0" />
                                                    <GradientStop Color="#EB151923" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <SkewTransform AngleX="{Binding PerspectiveAngle}" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <Border ClipToBounds="True" Style="{StaticResource StageCardStyle}">
                                            <Grid ClipToBounds="True">
                                                <ItemsControl Width="{Binding ScenePreviewWidth, Source={x:Reference thisWindow}}"
                                                              Height="{Binding ScenePreviewHeight, Source={x:Reference thisWindow}}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Top"
                                                              ClipToBounds="True"
                                                              ItemsSource="{Binding PreviewWindows}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <local:DwmThumbnail PreviewHandle="{Binding Handle}"
                                                                                Width="{Binding ScenePreviewWidth, Source={x:Reference thisWindow}}"
                                                                                Height="{Binding ScenePreviewHeight, Source={x:Reference thisWindow}}"
                                                                                Margin="{Binding PreviewMargin}"
                                                                                Panel.ZIndex="{Binding PreviewZIndex}"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border VerticalAlignment="Bottom" Background="#E0171A21" Padding="7,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ItemsControl ItemsSource="{Binding Windows}" Height="{Binding SceneIconHostHeight, Source={x:Reference thisWindow}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Image Width="{Binding SceneIconSize, Source={x:Reference thisWindow}}"
                                                                               Height="{Binding SceneIconSize, Source={x:Reference thisWindow}}"
                                                                               Margin="0,0,3,0" Source="{Binding Icon}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="10"
                                                                   MaxWidth="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Visibility="{Binding ExtraWindowVisibility}" Background="#E45A78C7"
                                                                CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                                                            <TextBlock Text="{Binding ExtraWindowLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Visibility="{Binding PerspectiveVisibility}"
                                                CornerRadius="13"
                                                BorderThickness="1"
                                                IsHitTestVisible="False">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#B8FFFFFF" Offset="0" />
                                                    <GradientStop Color="#31D5E0FA" Offset="0.42" />
                                                    <GradientStop Color="#68070A10" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#12FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                    <GradientStop Color="#1E000000" Offset="0.83" />
                                                    <GradientStop Color="#47000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <tb:TaskbarIcon x:Name="trayIcon"
                        Visibility="Visible"
                        ToolTipText="Stage_Manager_Lai v2.1.0"
                        IconSource="StageManager.ico"
                        MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem x:Name="coexistModeMenu" Header="Coexist mode" IsCheckable="True" Click="MenuItem_CoexistMode_Click" />
                    <MenuItem x:Name="focusModeMenu" Header="Focus mode" IsCheckable="True" Click="MenuItem_FocusMode_Click" />
                    <MenuItem x:Name="autoHideMenu" Header="Auto-hide sidebar" IsCheckable="True" Click="MenuItem_AutoHide_Click" />
                    <Separator />
                    <MenuItem Header="Settings..." Click="MenuItem_Settings_Click" />
                    <MenuItem x:Name="resumeSafeModeMenu" Header="Resume window management" Click="MenuItem_ResumeSafeMode_Click" />
                    <MenuItem Header="Open logs" Click="MenuItem_OpenLogs_Click" />
                    <MenuItem Header="Project page" Click="MenuItem_ProjectPage_Click" />
                    <Separator />
                    <MenuItem Header="Quit" Click="MenuItem_Quit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
